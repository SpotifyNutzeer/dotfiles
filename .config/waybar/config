{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 44,
    "margin-top": 8,
    "margin-left": 12,
    "margin-right": 12,
    "spacing": 6,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["cpu", "custom/cpu-power", "temperature", "memory", "custom/gpu-usage", "custom/gpu-power", "custom/gpu-vram", "network"],
    "modules-right": ["tray", "clock", "custom/powermenu"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate",
        "sort-by-number": true
    },

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip-format": "CPU: {usage}%\n{icon0}{icon1}{icon2}{icon3}"
    },

    "temperature": {
        "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
        "critical-threshold": 90,
        "format": "󰔏 {temperatureC}°C",
        "format-critical": "󰔏 {temperatureC}°C",
        "interval": 2
    },

    "memory": {
        "format": "󰍛 {used:.1f}G",
        "tooltip-format": "{used:.1f}G / {total:.1f}G",
        "interval": 2
    },

    "custom/cpu-power": {
        "exec": "~/.config/waybar/cpu-power.sh",
        "format": "󱐋 {}",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-power": {
        "exec": "nvidia-smi --query-gpu=power.draw --format=csv,noheader,nounits | awk '{printf \"%dW\", $1}'",
        "format": "󱐋 {}",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-usage": {
        "exec": "nvidia-smi --query-gpu=utilization.gpu --format=csv,noheader,nounits",
        "format": "󰢮 {}%",
        "interval": 2,
        "tooltip": false
    },

    "custom/gpu-vram": {
        "exec": "nvidia-smi --query-gpu=memory.used --format=csv,noheader,nounits | awk '{printf \"%dM\", $1}'",
        "format": "󰆧 {}",
        "interval": 2,
        "tooltip": false
    },

    "network": {
        "interval": 2,
        "format-ethernet": "󰁆 {bandwidthDownBytes} 󰁞 {bandwidthUpBytes}",
        "format-disconnected": "󰤭",
        "tooltip-format": "{ifname}: {ipaddr}"
    },

    "tray": {
        "spacing": 8,
        "icon-size": 18
    },

    "custom/powermenu": {
        "format": "󰐥",
        "on-click": "~/.config/waybar/powermenu.sh",
        "tooltip": false
    },

    "clock": {
        "format": "󰃰 {:%H:%M}",
        "format-alt": "{:%Y-%m-%d %H:%M:%S}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>"
    }
}
