* {
    base:     #1e1e2e;
    mantle:   #181825;
    crust:    #11111b;
    surface0: #313244;
    surface1: #45475a;
    surface2: #585b70;
    overlay0: #6c7086;
    text:     #cdd6f4;
    subtext0: #a6adc8;
    blue:     #89b4fa;
    mauve:    #cba6f7;
    green:    #a6e3a1;
    peach:    #fab387;
    red:      #f38ba8;
    pink:     #f5c2e7;

    background-color: transparent;
    text-color:       @text;
}

window {
    background-color: @base;
    border:           1px;
    border-color:     @surface1;
    border-radius:    14px;
    width:            600px;
    padding:          12px;
}

mainbox {
    background-color: transparent;
    children:         [ inputbar, listview ];
    spacing:          10px;
}

inputbar {
    background-color: @surface0;
    border:           1px;
    border-color:     @surface1;
    border-radius:    10px;
    padding:          10px 14px;
    children:         [ prompt, entry ];
    spacing:          6px;
}

prompt {
    background-color: transparent;
    text-color:       @blue;
    font:             "JetBrainsMono Nerd Font Bold 13";
}

entry {
    background-color: transparent;
    text-color:       @text;
    placeholder:      "Suchen...";
    placeholder-color: @overlay0;
}

listview {
    background-color: transparent;
    lines:            8;
    columns:          1;
    scrollbar:        false;
    spacing:          4px;
}

element {
    background-color: transparent;
    border-radius:    8px;
    padding:          8px 10px;
    spacing:          10px;
    orientation:      horizontal;
}

element normal.normal {
    background-color: transparent;
    text-color:       @text;
}

element selected.normal {
    background-color: @surface0;
    text-color:       @blue;
}

element alternate.normal {
    background-color: transparent;
    text-color:       @text;
}

element-icon {
    size:             24px;
    vertical-align:   0.5;
}

element-text {
    vertical-align:   0.5;
    text-color:       inherit;
}
